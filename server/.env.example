# Copy to .env (gitignored — never commit secrets).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model for agent brains. "openrouter/free" = default free model.
OPENROUTER_MODEL=openrouter/free
# llm = model tactics and generated conversations; scripted = silent deterministic activities
AI_MODE=llm
# gemini = Google AI Studio key (default, best quotas below); openrouter = OpenRouter.
AI_PROVIDER=gemini
# Gemini Developer API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Best-throughput primary: 15 RPM / 250K TPM / 500 RPD.
GEMINI_MODEL=gemini-3.5-flash-lite
# Smarter escalation for multi-suspect dispatch: 5 RPM / 250K TPM / 20 RPD.
# Lite fallback gemini-3.1-flash-lite (15 RPM / 500 RPD) is automatic.
GEMINI_ESCALATION_MODEL=gemini-3.8-flash
# Min ms between LLM goal decisions per room.
AI_BRAIN_INTERVAL_MS=8000
